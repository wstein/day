#!/bin/bash
# test-day: tests for the day binary (bash 3.2). Test data only in throw-away directories under $TMPDIR.
# Usage: go build -o day . && ./test-day     (DAY=<path> tests another build of day; no mutation proofs, prototype)
set -u
HERE=$(cd "$(dirname "$0")" && pwd)
DAY=${DAY:-$HERE/day}
BASE=${TMPDIR:-/tmp}
T=$(mktemp -d "$BASE/daytest.XXXXXX") || exit 1
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
mkdir -p "$T/home"
export HOME="$T/home" GIT_CONFIG_NOSYSTEM=1 DAY_GIT_NAME=Tester DAY_GIT_EMAIL=t@example.invalid
unset DAY_DIR GIT_DIR GIT_WORK_TREE
export GIT_CEILING_DIRECTORIES="$T"   # a TMPDIR inside a real repo must never be picked up
PASS=0; FAILN=0
chk() { local l=$1; shift; if "$@"; then PASS=$((PASS+1)); else FAILN=$((FAILN+1)); echo "FAIL: $l"; fi; }
eq() { [ "$1" = "$2" ]; }
has() { printf '%s\n' "$1" | grep -qF -- "$2"; }
run() { OUT=$("$DAY" "$@" 2>&1); RC=$?; }
G() { git -C "$1" "${@:2}"; }
head_of() { G "$1" rev-parse HEAD 2>/dev/null; }
sum() { cksum < "$1"; }

ents() { local i=1; while [ "$i" -le "$1" ]; do printf -- '- e%s\n' "$i"; i=$((i+1)); done; }
mkws() { # dir: workspace repo with a root commit that already ignores dayboard/DAYBOARD.md
  git init -q -b main "$1"; printf 'dayboard/DAYBOARD.md\n' > "$1/.gitignore"
  G "$1" add .gitignore; G "$1" -c user.name=x -c user.email=x@x commit -q -m root
}
mkboard() { # dir date nJetzt nHeute nWartet
  mkdir -p "$1"
  { printf '# Dayboard (Stand %s)\n\n## Jetzt\n' "$2"; ents "$3"; printf '\n## Heute\n'; ents "$4"
    printf '\n## Wartet auf Owner\n'; ents "$5"
    printf '\n## Geparkt\n\n## Erledigt heute\n\n<!-- stw:begin -->\nfacts\n<!-- stw:end -->\n'; } > "$1/DAYBOARD.md"
}
edit() { sed "$2" "$1/DAYBOARD.md" > "$1/n.tmp" && mv "$1/n.tmp" "$1/DAYBOARD.md"; }
checkrun() { run check --dir "$1" --date 2026-11-04; }

# Seed mit Einträgen und Fakten-Block mit Sonderzeichen
SEED="$T/seed.md"
printf '# Dayboard (Stand 2026-11-03)\n\n## Jetzt\n- a\n\n## Heute\n- b\n\n## Wartet auf Owner\n\n## Geparkt\n- g\n\n## Erledigt heute\n- done eins\n- done zwei ä\n\n<!-- stw:begin -->\nFakten:  \n- x\t\xc3\xa4 \n<!-- stw:end -->\n' > "$SEED"
EMPTY="$T/empty.md"
sed '/^- done/d' "$SEED" > "$EMPTY"

# --- init ---
WS="$T/ws"; mkws "$WS"; B1="$WS/dayboard"
run init --dir "$B1" --date 2026-11-04
chk "init: exit 0" eq "$RC" 0
chk "init: kein eigenes .git" test ! -e "$B1/.git"
chk "init: DAYBOARD.md Kopfzeile" eq "$(head -1 "$B1/DAYBOARD.md")" "# Dayboard (Stand 2026-11-04)"
chk "init: 5 Abschnitte" eq "$(grep -c '^## ' "$B1/DAYBOARD.md")" 5
chk "init: leerer Fakten-Block" eq "$(grep -c 'stw:' "$B1/DAYBOARD.md")" 2
chk "init: LOGBOOK append-only" grep -q 'append-only' "$B1/LOGBOOK.md"
chk "init: BACKLOG angelegt" grep -q '^## Next' "$B1/BACKLOG.md"
chk "init: BACKLOG im Commit" has "$(G "$WS" ls-files)" "dayboard/BACKLOG.md"
chk "init: LOGBOOK im Commit" has "$(G "$WS" ls-files)" "dayboard/LOGBOOK.md"
chk "init: DAYBOARD nicht getrackt" eq "$(G "$WS" ls-files | grep -c DAYBOARD)" 0
chk "init: ein Commit zusätzlich" eq "$(G "$WS" rev-list --count HEAD)" 2
chk "init: Commit-Betreff" eq "$(G "$B1" log -1 --format=%s)" "dayboard: init"
chk "init: Commit ohne Trailer" eq "$(G "$B1" log -1 --format=%B | grep -c .)" 1
chk "init: Autor und Committer" eq "$(G "$B1" log -1 --format='%an <%ae> | %cn <%ce>')" "Tester <t@example.invalid> | Tester <t@example.invalid>"
chk "init: kein Remote" eq "$(G "$WS" remote | wc -l | tr -d ' ')" 0
chk "init: Arbeitsbaum sauber (DAYBOARD ignoriert)" eq "$(G "$WS" status --porcelain)" ""
chk "init: Config ohne user" eq "$(G "$WS" config --local --get user.name | wc -l | tr -d ' ')" 0
chk "init: kein Legacy-Hinweis" eq "$(printf '%s' "$OUT" | grep -c 'eigenes .git')" 0

H1=$(head_of "$B1"); S1=$(sum "$B1/DAYBOARD.md"); L1=$(sum "$B1/LOGBOOK.md"); BL1=$(sum "$B1/BACKLOG.md")
run init --dir "$B1" --date 2026-11-09
chk "init2: exit 0" eq "$RC" 0
chk "init2: HEAD gleich" eq "$(head_of "$B1")" "$H1"
chk "init2: DAYBOARD unverändert" eq "$(sum "$B1/DAYBOARD.md")" "$S1"
chk "init2: BACKLOG unverändert" eq "$(sum "$B1/BACKLOG.md")" "$BL1"
chk "init2: LOGBOOK unverändert" eq "$(sum "$B1/LOGBOOK.md")" "$L1"
chk "init2: meldet vorhanden" has "$OUT" "vorhanden"

B2="$T/b2"
run init --dir "$B2" --seed "$SEED"
chk "seed: exit 0" eq "$RC" 0
chk "seed: Datei übernommen" cmp -s "$SEED" "$B2/DAYBOARD.md"
chk "seed: kein Repo, kein Commit" test ! -e "$B2/.git"
run init --dir "$T/b2x" --seed "$T/nichtda.md"
chk "seed fehlt: exit 2" eq "$RC" 2

B3="$T/b3"; mkdir -p "$B3"; printf 'meins\n' > "$B3/DAYBOARD.md"
run init --dir "$B3" --seed "$SEED"
chk "bestehend: exit 0" eq "$RC" 0
chk "bestehend: nicht überschrieben" eq "$(cat "$B3/DAYBOARD.md")" meins
chk "bestehend: gemeldet" has "$OUT" "DAYBOARD.md: vorhanden"
chk "bestehend: LOGBOOK angelegt" test -f "$B3/LOGBOOK.md"

# innerhalb eines anderen Repos, DAYBOARD.md nicht ignoriert: Hinweis, keine Exclude-Änderung
R="$T/outer"; git init -q -b main "$R"; git -C "$R" -c user.name=x -c user.email=x@x commit -q --allow-empty -m root
rm -f "$R/.git/info/exclude"
CFG=$(sum "$R/.git/config")
run init --dir "$R/sub/board" --date 2026-11-04
chk "outer: exit 0" eq "$RC" 0
chk "outer: kein Exclude-Eintrag" test ! -e "$R/.git/info/exclude"
chk "outer: Hinweis auf .gitignore" has "$OUT" ".gitignore"
chk "outer: kein eigenes Repo" test ! -e "$R/sub/board/.git"
chk "outer: nur BACKLOG und LOGBOOK im Commit" eq "$(G "$R" show --name-only --format= HEAD | tr '\n' ';')" "sub/board/BACKLOG.md;sub/board/LOGBOOK.md;"
chk "outer: DAYBOARD bleibt untracked" eq "$(G "$R" status --porcelain)" "?? sub/board/DAYBOARD.md"
chk "outer: config unberührt" eq "$(sum "$R/.git/config")" "$CFG"
run init --dir "$R/sub/board" --date 2026-11-04
chk "outer2: nichts mehr zu committen" eq "$(G "$R" rev-list --count HEAD)" 2

# Linked worktree: Default-Board im Haupt-Checkout
W="$T/wt"; G "$WS" worktree add -q -b wtb "$W"
mkdir -p "$W/deep"
OUT=$(cd "$W/deep" && "$DAY" check --date 2026-11-04 2>&1); RC=$?
chk "worktree: check findet Board im Haupt-Checkout" eq "$RC" 0
OUT=$(cd "$W/deep" && "$DAY" rollover --date 2026-11-09 2>&1); RC=$?
chk "worktree: rollover exit 0" eq "$RC" 0
chk "worktree: Board im Haupt-Checkout aktualisiert" eq "$(head -1 "$WS/dayboard/DAYBOARD.md")" "# Dayboard (Stand 2026-11-09)"
chk "worktree: kein DAYBOARD.md im Worktree" test ! -e "$W/dayboard/DAYBOARD.md"
chk "worktree: leeres Erledigt: kein neuer Commit" eq "$(G "$WS" log -1 --format=%s)" "dayboard: init"
W2="$T/wt2"; R2="$T/ws2"; mkws "$R2"; G "$R2" worktree add -q -b w2 "$W2"
OUT=$(cd "$W2" && "$DAY" init --date 2026-11-04 2>&1); RC=$?
chk "worktree init: exit 0" eq "$RC" 0
chk "worktree init: Board im Haupt-Checkout" test -f "$R2/dayboard/DAYBOARD.md"
chk "worktree init: nichts im Worktree" test ! -e "$W2/dayboard"

# Identität (nur das Legacy-Repo verlangt sie; ein umgebendes Repo nutzt notfalls seine eigene Config)
mkdir -p "$T/b6"; git init -q "$T/b6"
OUT=$(env -u DAY_GIT_NAME -u DAY_GIT_EMAIL "$DAY" init --dir "$T/b6" 2>&1); RC=$?
chk "ohne Identität (Legacy): exit 2" eq "$RC" 2
chk "ohne Identität (Legacy): Meldung" has "$OUT" "DAY_GIT_NAME"
chk "ohne Identität (Legacy): nichts angelegt" test ! -e "$T/b6/DAYBOARD.md"
mkdir -p "$T/home2"; printf '[user]\n\tname = Glob\n\temail = g@example.invalid\n' > "$T/home2/.gitconfig"
OUT=$(env -u DAY_GIT_NAME -u DAY_GIT_EMAIL HOME="$T/home2" "$DAY" init --dir "$T/b6" 2>&1); RC=$?
chk "global Identität: exit 0" eq "$RC" 0
chk "global Identität: Autor" eq "$(G "$T/b6" log -1 --format=%an)" Glob
chk "global Identität: Committer-Mail" eq "$(G "$T/b6" log -1 --format=%ce)" g@example.invalid
chk "global Identität: Config nicht geschrieben" eq "$(G "$T/b6" config --local --get user.name | wc -l | tr -d ' ')" 0
chk "Legacy: Hinweis zur Migration" has "$OUT" "eigenes .git"
chk "Legacy: Hinweis nennt .gitignore" has "$OUT" "DAYBOARD.md"
chk "Legacy: Hinweis nennt info/exclude" has "$OUT" "info/exclude"
chk "Legacy: Commit im verschachtelten Repo inkl. DAYBOARD" has "$(G "$T/b6" ls-files)" "DAYBOARD.md"

# init --dry-run
run init --dir "$T/b8" --seed "$SEED" --dry-run
chk "init dry-run: exit 0" eq "$RC" 0
chk "init dry-run: nichts angelegt" test ! -e "$T/b8"
run init --dir "$R/sub/dry" --dry-run
chk "init dry-run: nichts angelegt (Repo)" test ! -e "$R/sub/dry"
chk "init dry-run: Hinweis" has "$OUT" ".gitignore"
chk "init dry-run: BACKLOG gemeldet" has "$OUT" "BACKLOG.md: angelegt"

# --- rollover ---
run rollover --dir "$B1" --date 2026-11-09
chk "rollover gleicher Tag: exit 0" eq "$RC" 0
chk "rollover gleicher Tag: Meldung" eq "$OUT" "nothing to roll over"
chk "rollover gleicher Tag: HEAD gleich" eq "$(head_of "$B1")" "$H1"

W7="$T/ws7"; mkws "$W7"; B7="$W7/dayboard"; run init --dir "$B7" --seed "$SEED"
printf '\n## 2026-11-02\n- alt\n' >> "$B7/LOGBOOK.md"; G "$B7" add LOGBOOK.md; G "$B7" -c user.name=x -c user.email=x@x commit -q -m prep
printf 'x\n' > "$B7/other.txt"; printf 'y\n' > "$B7/staged.txt"; G "$B7" add staged.txt
cp "$B7/DAYBOARD.md" "$T/old.md"; cp "$B7/LOGBOOK.md" "$T/oldlog.md"
sed -n '/stw:begin/,/stw:end/p' "$B7/DAYBOARD.md" > "$T/facts.before"
H7=$(head_of "$B7")
run rollover --dir "$B7" --date 2026-11-05 --dry-run
chk "rollover dry-run: exit 0" eq "$RC" 0
chk "rollover dry-run: DAYBOARD unverändert" cmp -s "$T/old.md" "$B7/DAYBOARD.md"
chk "rollover dry-run: LOGBOOK unverändert" cmp -s "$T/oldlog.md" "$B7/LOGBOOK.md"
chk "rollover dry-run: HEAD gleich" eq "$(head_of "$B7")" "$H7"
run rollover --dir "$B7" --date 2026-11-05
chk "rollover: exit 0" eq "$RC" 0
chk "rollover: Kopfzeile" eq "$(head -1 "$B7/DAYBOARD.md")" "# Dayboard (Stand 2026-11-05)"
chk "rollover: Logbuch-Block" has "$(cat "$B7/LOGBOOK.md")" "## 2026-11-03"
chk "rollover: Logbuch-Zeilen" has "$(tail -3 "$B7/LOGBOOK.md")" "- done zwei ä"
chk "rollover: Logbuch-Anfang unverändert" cmp -s "$T/oldlog.md" <(head -c "$(wc -c < "$T/oldlog.md")" "$B7/LOGBOOK.md")
chk "rollover: Logbuch genau 2 Zeilen angehängt" eq "$(($(wc -l < "$B7/LOGBOOK.md")-$(wc -l < "$T/oldlog.md")))" 4
sed -e 's/^# Dayboard (Stand 2026-11-03)/# Dayboard (Stand 2026-11-05)/' -e '/^- done/d' "$T/old.md" > "$T/expect.md"
chk "rollover: Board bis auf Kopf/Erledigt gleich" cmp -s "$T/expect.md" "$B7/DAYBOARD.md"
chk "rollover: Überschrift Erledigt bleibt" grep -qx '## Erledigt heute' "$B7/DAYBOARD.md"
sed -n '/stw:begin/,/stw:end/p' "$B7/DAYBOARD.md" > "$T/facts.after"
chk "rollover: Fakten-Block byte-gleich" cmp -s "$T/facts.before" "$T/facts.after"
chk "rollover: Betreff" eq "$(G "$B7" log -1 --format=%s)" "dayboard: 2026-11-03"
chk "rollover: genau 1 Datei (LOGBOOK)" eq "$(G "$B7" show --name-only --format= HEAD | tr '\n' ';')" "dayboard/LOGBOOK.md;"
chk "rollover: fremde Datei unberührt, Staged bleibt staged" eq "$(G "$B7" status --porcelain | sort | tr '\n' ';')" "?? dayboard/other.txt;A  dayboard/staged.txt;"
chk "rollover: DAYBOARD nie committet" eq "$(G "$B7" log --all --name-only --format= | grep -c DAYBOARD)" 0
chk "rollover: Commit ohne Trailer" eq "$(G "$B7" log -1 --format=%B | grep -c .)" 1
chk "rollover: Autor" eq "$(G "$B7" log -1 --format='%an|%cn')" "Tester|Tester"
run rollover --dir "$B7" --date 2026-11-05
chk "rollover danach: nichts mehr" eq "$OUT" "nothing to roll over"

W9="$T/ws9"; mkws "$W9"; B9="$W9/dayboard"; run init --dir "$B9" --seed "$EMPTY"
cp "$B9/LOGBOOK.md" "$T/log9"; H9=$(head_of "$B9")
run rollover --dir "$B9" --date 2026-11-05
chk "rollover leer: exit 0" eq "$RC" 0
chk "rollover leer: Kopfzeile" eq "$(head -1 "$B9/DAYBOARD.md")" "# Dayboard (Stand 2026-11-05)"
chk "rollover leer: Logbuch unverändert" cmp -s "$T/log9" "$B9/LOGBOOK.md"
chk "rollover leer: kein Commit (nur DAYBOARD geändert)" eq "$(head_of "$B9")" "$H9"
chk "rollover leer: Rest gleich" cmp -s <(sed 1d "$EMPTY") <(sed 1d "$B9/DAYBOARD.md")
B10="$T/b10"; mkdir -p "$B10"; cp "$SEED" "$B10/DAYBOARD.md"
run rollover --dir "$B10" --date 2026-11-05
chk "rollover ohne Repo: exit 0" eq "$RC" 0
chk "rollover ohne Repo: Board geschrieben" eq "$(head -1 "$B10/DAYBOARD.md")" "# Dayboard (Stand 2026-11-05)"
chk "rollover ohne Repo: Logbuch geschrieben" has "$(cat "$B10/LOGBOOK.md")" "- done eins"
chk "rollover ohne Repo: kein .git" test ! -e "$B10/.git"
chk "rollover ohne Repo: keine Warnung" eq "$OUT" "rolled over 2026-11-03: 2 Zeilen ins Logbuch, Stand 2026-11-05"

# Rebase/Merge im umgebenden Repo oder Commit-Fehler: warnen, Dateien bleiben geändert, exit 0
WB="$T/wsb"; mkws "$WB"; run init --dir "$WB/dayboard" --seed "$SEED"
touch "$WB/.git/MERGE_HEAD"; HB=$(head_of "$WB")
run rollover --dir "$WB/dayboard" --date 2026-11-05
chk "Merge läuft: exit 0" eq "$RC" 0
chk "Merge läuft: Warnung" has "$OUT" "Warnung"
chk "Merge läuft: kein Commit" eq "$(head_of "$WB")" "$HB"
chk "Merge läuft: Logbuch geändert" has "$(cat "$WB/dayboard/LOGBOOK.md")" "- done eins"
rm -f "$WB/.git/MERGE_HEAD"
chk "Merge läuft: Index unverändert" eq "$(G "$WB" diff --cached --name-only)" ""
for BUSY in CHERRY_PICK_HEAD REVERT_HEAD; do
  cp "$SEED" "$WB/dayboard/DAYBOARD.md"; touch "$WB/.git/$BUSY"; run rollover --dir "$WB/dayboard" --date 2026-11-06
  chk "$BUSY: Warnung, exit 0" eq "$RC$(has "$OUT" Warnung && echo w)" "0w"
  chk "$BUSY: Index unverändert" eq "$(G "$WB" diff --cached --name-only)" ""
  rm -f "$WB/.git/$BUSY"
done
cp "$SEED" "$WB/dayboard/DAYBOARD.md"; mkdir "$WB/.git/sequencer"; run rollover --dir "$WB/dayboard" --date 2026-11-07
chk "sequencer: Warnung" has "$OUT" "Warnung"
chk "sequencer: Index unverändert" eq "$(G "$WB" diff --cached --name-only)" ""
rmdir "$WB/.git/sequencer"

# Hook lehnt den Commit ab: Warnung, Index zurückgesetzt; später init holt die untracked Dateien nach
WH="$T/wsh"; mkws "$WH"; printf '#!/bin/sh\nexit 1\n' > "$WH/.git/hooks/pre-commit"; chmod +x "$WH/.git/hooks/pre-commit"
run init --dir "$WH/dayboard" --date 2026-11-04
chk "Hook: exit 0" eq "$RC" 0
chk "Hook: Warnung" has "$OUT" "Commit fehlgeschlagen"
chk "Hook: Index leer" eq "$(G "$WH" diff --cached --name-only)" ""
chk "Hook: Dateien vorhanden, untracked" has "$(G "$WH" status --porcelain)" "?? dayboard/"
rm "$WH/.git/hooks/pre-commit"
printf 'x\n' > "$WH/other.txt"; G "$WH" add other.txt
run init --dir "$WH/dayboard" --date 2026-11-04
chk "Nachholen: committet BACKLOG/LOGBOOK" eq "$(G "$WH" show --name-only --format= HEAD | tr '\n' ';')" "dayboard/BACKLOG.md;dayboard/LOGBOOK.md;"
chk "Nachholen: fremde Datei bleibt staged" eq "$(G "$WH" diff --cached --name-only)" "other.txt"

# Ignorierte Zieldatei (altes dayboard/ in .gitignore): Warnung nennt die ignorierende Zeile
WI="$T/wsi"; mkws "$WI"; printf 'dayboard/\n' > "$WI/.gitignore"; G "$WI" add .gitignore; G "$WI" -c user.name=x -c user.email=x@x commit -q -m ign
run init --dir "$WI/dayboard" --date 2026-11-04
chk "ignoriert: exit 0" eq "$RC" 0
chk "ignoriert: Warnung mit Datei:Zeile" has "$OUT" ".gitignore:1"
chk "ignoriert: git-Meldung" has "$OUT" "ignored"
chk "ignoriert: Index leer" eq "$(G "$WI" diff --cached --name-only)" ""

# Identität einzeln: nur DAY_GIT_NAME gesetzt, E-Mail aus der Repo-Config
WN="$T/wsn"; mkws "$WN"; G "$WN" config user.email repo@example.invalid
OUT=$(env -u DAY_GIT_EMAIL DAY_GIT_NAME=Nur "$DAY" init --dir "$WN/dayboard" --date 2026-11-04 2>&1); RC=$?
chk "Identität einzeln: Autor" eq "$(G "$WN" log -1 --format='%an <%ae>')" "Nur <repo@example.invalid>"

# Bare proj/.git mit Worktree: Board im Worktree, nicht neben proj/.git
git init -q -b main "$T/src"; G "$T/src" -c user.name=x -c user.email=x@x commit -q --allow-empty -m root
mkdir -p "$T/proj"; git clone -q --bare "$T/src" "$T/proj/.git"
git --git-dir="$T/proj/.git" worktree add -q -b wk "$T/proj/wk" main
OUT=$(cd "$T/proj/wk" && "$DAY" init --date 2026-11-04 2>&1); RC=$?
chk "bare .git: exit 0" eq "$RC" 0
chk "bare .git: Board im Worktree" test -f "$T/proj/wk/dayboard/DAYBOARD.md"
chk "bare .git: nichts neben .git" test ! -e "$T/proj/dayboard"

# Legacy: eigenes .git im Board-Ordner (auch innerhalb eines Workspaces) wie bisher, mit Hinweis
WL="$T/wsl"; mkws "$WL"; mkdir -p "$WL/dayboard"; git init -q -b main "$WL/dayboard"
run init --dir "$WL/dayboard" --seed "$SEED"
chk "legacy init: exit 0" eq "$RC" 0
chk "legacy init: Hinweis" has "$OUT" "eigenes .git"
chk "legacy init: Commit im verschachtelten Repo" eq "$(G "$WL/dayboard" log -1 --format=%s)" "dayboard: init"
chk "legacy init: Workspace unberührt" eq "$(G "$WL" rev-list --count HEAD)" 1
run rollover --dir "$WL/dayboard" --date 2026-11-05
chk "legacy rollover: exit 0" eq "$RC" 0
chk "legacy rollover: Hinweis genau einmal" eq "$(printf '%s\n' "$OUT" | grep -c 'eigenes .git')" 1
chk "legacy rollover: Commit im verschachtelten Repo" eq "$(G "$WL/dayboard" log -1 --format=%s)" "dayboard: 2026-11-03"
chk "legacy rollover: 2 Dateien committet" eq "$(G "$WL/dayboard" show --name-only --format= HEAD | wc -l | tr -d ' ')" 2
run rollover --dir "$T/gibtsnicht"
chk "rollover ohne Board: exit 2" eq "$RC" 2

# --- check ---
C="$T/c"; mkboard "$C" 2026-11-04 1 3 5
checkrun "$C"
chk "check sauber: exit 0" eq "$RC" 0
chk "check sauber: still" eq "$OUT" ""
mkboard "$C" 2026-11-03 0 0 0; checkrun "$C"
chk "check Datum: exit 1" eq "$RC" 1
chk "check Datum: Meldung" has "$OUT" "Kopfzeile: Datum 2026-11-03 ungleich heute 2026-11-04"
chk "check Datum: nur ein Fund" eq "$(printf '%s\n' "$OUT" | wc -l | tr -d ' ')" 1
mkboard "$C" 2026-11-04 0 0 0; edit "$C" '1s/.*/Dayboard/'; checkrun "$C"
chk "check Kopfzeile ungültig" has "$OUT" "Kopfzeile: fehlt"
mkboard "$C" 2026-11-04 0 0 0; edit "$C" '/^## Geparkt/d'; checkrun "$C"
chk "check Abschnitt fehlt" eq "$OUT" "Geparkt: Abschnitt fehlt"
mkboard "$C" 2026-11-04 2 0 0; checkrun "$C"
chk "check Jetzt 2: Fund" eq "$OUT" "Jetzt: 2 Einträge (max 1)"
mkboard "$C" 2026-11-04 0 4 0; checkrun "$C"
chk "check Heute 4: Fund" eq "$OUT" "Heute: 4 Einträge (max 3)"
mkboard "$C" 2026-11-04 0 0 6; checkrun "$C"
chk "check Wartet 6: Fund" eq "$OUT" "Wartet auf Owner: 6 Einträge (max 5)"
mkboard "$C" 2026-11-04 0 0 0; edit "$C" 's/^## Heute/&\
- erste\
  Fortsetzung/'; checkrun "$C"
chk "check mehrzeilig" eq "$OUT" "Heute: Zeile 7 ist kein einzeiliger Eintrag"
L240=$(printf 'x%.0s' $(seq 1 238)); L241=$(printf 'x%.0s' $(seq 1 239))
mkboard "$C" 2026-11-04 0 0 0; edit "$C" "s/^## Geparkt/&\\
- $L240/"; checkrun "$C"
chk "check 240 Zeichen: sauber" eq "$RC" 0
mkboard "$C" 2026-11-04 0 0 0; edit "$C" "s/^## Geparkt/&\\
- $L241/"; checkrun "$C"
chk "check 241 Zeichen: Fund" has "$OUT" "Geparkt: Zeile 10 hat 241 Zeichen (max 240)"
mkboard "$C" 2026-11-04 0 0 0; edit "$C" '/stw:/d;/^facts$/d'; checkrun "$C"
